# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# По умолчанию — SQLite-файл рядом с ботом. В docker-compose подставляется Postgres.
DATABASE_URL=sqlite+aiosqlite:///booking.db
# REDIS_URL=redis://localhost:6379/0

BUSINESS_NAME=Barber Studio
BUSINESS_ADDRESS=ул. Примерная, 1
BUSINESS_PHONE=+7 (900) 000-00-00

TIMEZONE=Europe/Moscow
WORK_START=10:00
WORK_END=20:00
# 0 — понедельник ... 6 — воскресенье
WORK_WEEKDAYS=0,1,2,3,4,5
SLOT_STEP_MINUTES=30
BOOKING_DAYS_AHEAD=14
# Ежедневный перерыв (пусто — без перерыва). Разовые выходные задаются в админке.
LUNCH_BREAK=

# Сколько предстоящих записей может быть у одного клиента
MAX_ACTIVE_BOOKINGS=3
# Клиент может отменить запись не позже чем за N часов (0 — в любой момент)
CANCEL_MIN_HOURS=2
# Антифлуд: минимальный интервал между действиями пользователя, секунды
THROTTLE_SECONDS=0.5
